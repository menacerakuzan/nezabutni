// ---------------- АУДИТ / БЕЗПЕКА ----------------

model AuditLog {
  id         BigInt   @id @default(autoincrement())
  actorId    String?  @map("actor_id") @db.Uuid
  actor      AppUser? @relation(fields: [actorId], references: [id])
  action     String   @db.VarChar(100)
  entityType String?  @map("entity_type") @db.VarChar(30)
  entityId   String?  @map("entity_id") @db.Uuid
  diff       Json?
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @map("user_agent") @db.VarChar(500)
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([entityType, entityId])
  @@index([createdAt])
  @@index([actorId])
  @@map("audit_log")
}

model ConsentRecord {
  id               String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String     @map("user_id") @db.Uuid
  user             AppUser    @relation(fields: [userId], references: [id])
  defenderId       String?    @map("defender_id") @db.Uuid
  defender         Defender?  @relation(fields: [defenderId], references: [id])
  consentType      String     @map("consent_type") @db.VarChar(50)
  granted          Boolean
  documentMediaId  String?    @map("document_media_id") @db.Uuid
  documentMedia    MediaAsset? @relation(fields: [documentMediaId], references: [id])
  createdAt        DateTime   @default(now()) @map("created_at")

  @@map("consent_record")
}

// ─────────────────────────────────────────────────────────────
// CMS: те, що раніше було зашите в код фронтенду
// ─────────────────────────────────────────────────────────────

/// Пункт навігації. Редагується в адмінці, віддається публічним API.
model MenuItem {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  label     String   @db.VarChar(120)
  href      String   @db.VarChar(255)
  /// header | footer_memorial | footer_platform | footer_join
  location  String   @db.VarChar(40)
  parentId  String?  @map("parent_id") @db.Uuid
  parent    MenuItem?  @relation("MenuChildren", fields: [parentId], references: [id])
  children  MenuItem[] @relation("MenuChildren")
  sortOrder Int      @default(0) @map("sort_order") @db.SmallInt
  visible   Boolean  @default(true)
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([location, sortOrder])
  @@map("menu_item")
}

/// Блок сторінки: порядок і видимість секцій без правок коду.
model PageBlock {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// home | museum | map | about …
  page      String   @db.VarChar(60)
  /// Ключ компонента в дизайн-системі (FieldOfLights, MemorialWall…)
  blockType String   @map("block_type") @db.VarChar(80)
  label     String   @db.VarChar(200)
  /// Довільні пропси блока — заголовки, підписи, посилання.
  props     Json?
  sortOrder Int      @default(0) @map("sort_order") @db.SmallInt
  visible   Boolean  @default(true)
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([page, sortOrder])
  @@map("page_block")
}

/// Новини платформи: оголошення, події громад, пам'ятні дати.
model NewsPost {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title       String    @db.VarChar(200)
  slug        String    @unique @db.VarChar(220)
  category    String    @db.VarChar(60)
  excerpt     String?   @db.VarChar(400)
  body        String
  status      String    @default("draft") @db.VarChar(20)
  authorId    String?   @map("author_id") @db.Uuid
  author      AppUser?  @relation(fields: [authorId], references: [id])
  publishedAt DateTime? @map("published_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@index([status, publishedAt])
  @@map("news_post")
}

/// Ключ-значення для налаштувань сайту, що раніше були зашиті в код
/// (контактна пошта, назва платформи, соцмережі тощо).
model SiteSetting {
  key         String   @id @db.VarChar(80)
  value       String
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("site_setting")
}
